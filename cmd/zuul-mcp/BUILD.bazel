load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "zuul-mcp_lib",
    srcs = ["main.go"],
    importpath = "github.com/clappingmonkey/zuul-mcp/cmd/zuul-mcp",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/config",
        "//internal/server",
        "//internal/transport",
        "@com_github_mark3labs_mcp_go//server",
    ],
)

go_binary(
    name = "zuul-mcp",
    embed = [":zuul-mcp_lib"],
    visibility = ["//visibility:public"],
    x_defs = {
        "main.version": "{STABLE_GIT_TAG}",
        "main.commit": "{STABLE_GIT_COMMIT}",
        "main.date": "{BUILD_DATE}",
    },
)

go_test(
    name = "zuul-mcp_test",
    srcs = ["main_test.go"],
    embed = [":zuul-mcp_lib"],
    deps = [
        "//internal/config",
        "//internal/server",
    ],
)

{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    ':automergeMinor',
  ],
  enabledManagers: [
    'bazel-module',
    'bazelisk',
    'gomod',
    'github-actions',
    'custom.regex',
  ],
  platformAutomerge: true,
  platformCommit: 'enabled',
  prHourlyLimit: 4,
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/MODULE\\.bazel$/',
      ],
      matchStrings: [
        'go_sdk\\.download\\(version\\s*=\\s*"(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: 'golang/go',
      datasourceTemplate: 'github-tags',
      extractVersionTemplate: '^go(?<version>.*)$',
    },
  ],
  packageRules: [
    {
      description: 'Group all Bazel dependency updates',
      matchManagers: [
        'bazel-module',
      ],
      groupName: 'bazel dependencies',
      labels: [
        'dependencies',
        'bazel',
      ],
    },
    {
      description: 'Group Go SDK (Bazel) with Go toolchain version in go.mod',
      matchDatasources: [
        'github-tags',
      ],
      matchDepNames: [
        'golang/go',
      ],
      groupName: 'go toolchain',
      labels: [
        'dependencies',
        'go',
      ],
      // The custom.regex manager only text-edits go_sdk.download() in
      // MODULE.bazel; it does not regenerate MODULE.bazel.lock, so the Go SDK
      // download entries (go1.x.y.*) go stale and the Gazelle CI check fails.
      // Regenerate the lock here so the PR is self-consistent. bazelisk is
      // installed via installTools (Containerbase) and the command must be
      // allow-listed via RENOVATE_ALLOWED_COMMANDS in the Renovate workflow.
      postUpgradeTasks: {
        commands: [
          'bazel run //:gazelle --config=ci',
        ],
        fileFilters: [
          'MODULE.bazel.lock',
        ],
        executionMode: 'branch',
        installTools: {
          bazelisk: {},
        },
      },
    },
    {
      description: 'Group Go module dependency updates',
      matchManagers: [
        'gomod',
      ],
      matchDepTypes: [
        'require',
        'indirect',
      ],
      enabled: true,
      groupName: 'go dependencies',
      labels: [
        'dependencies',
        'go',
      ],
    },
    {
      description: 'Group Go toolchain version from go.mod with Bazel Go SDK',
      matchManagers: [
        'gomod',
      ],
      matchDepTypes: [
        'golang',
      ],
      enabled: true,
      rangeStrategy: 'bump',
      groupName: 'go toolchain',
      labels: [
        'dependencies',
        'go',
      ],
    },
    {
      description: 'Group all GitHub Actions updates',
      matchManagers: [
        'github-actions',
      ],
      groupName: 'github actions',
      labels: [
        'dependencies',
        'github-actions',
      ],
    },
    {
      description: 'Major updates require manual review',
      matchUpdateTypes: [
        'major',
      ],
      labels: [
        'dependencies',
        'major',
      ],
      automerge: false,
    },
  ],
}

{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    ':automergeMinor',
  ],
  enabledManagers: [
    'bazel-module',
    'bazelisk',
    'gomod',
    'github-actions',
    'pre-commit',
    'custom.regex',
  ],
  // The pre-commit manager is opt-in; it updates the hook revs (kept as
  // SHA + '# frozen: vX' comments) in .pre-commit-config.yaml.
  'pre-commit': {
    enabled: true,
  },
  platformAutomerge: true,
  platformCommit: 'enabled',
  prHourlyLimit: 4,
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/MODULE\\.bazel$/',
      ],
      matchStrings: [
        'go_sdk\\.download\\(version\\s*=\\s*"(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: 'golang/go',
      datasourceTemplate: 'github-tags',
      extractVersionTemplate: '^go(?<version>.*)$',
    },
    {
      customType: 'regex',
      description: 'govulncheck version run by the vulnerability scan workflow',
      managerFilePatterns: [
        '/^\\.github/workflows/vulnerability-scan\\.yaml$/',
      ],
      matchStrings: [
        'GOVULNCHECK_VERSION\\s*:\\s*["\']?(?<currentValue>v\\d+\\.\\d+\\.\\d+)["\']?',
      ],
      depNameTemplate: 'golang.org/x/vuln',
      datasourceTemplate: 'go',
    },
    {
      customType: 'regex',
      description: 'golangci-lint release archives in MODULE.bazel',
      managerFilePatterns: [
        '/MODULE\\.bazel$/',
      ],
      matchStrings: [
        'GOLANGCI_LINT_VERSION\\s*=\\s*["\'](?<currentValue>\\d+\\.\\d+\\.\\d+)["\']',
      ],
      depNameTemplate: 'golangci/golangci-lint',
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
  ],
  packageRules: [
    {
      description: 'Group all Bazel dependency updates',
      matchManagers: [
        'bazel-module',
      ],
      groupName: 'bazel dependencies',
      labels: [
        'dependencies',
        'bazel',
      ],
    },
    {
      description: 'Group Go SDK (Bazel) with Go toolchain version in go.mod',
      matchDatasources: [
        'github-tags',
      ],
      matchDepNames: [
        'golang/go',
      ],
      groupName: 'go toolchain',
      labels: [
        'dependencies',
        'go',
      ],
      // The custom.regex manager only text-edits go_sdk.download() in
      // MODULE.bazel; it does not regenerate MODULE.bazel.lock, so the Go SDK
      // download entries (go1.x.y.*) go stale and the Gazelle CI check fails.
      // Regenerate the lock here so the PR is self-consistent. bazelisk is
      // installed via installTools (Containerbase) and the command must be
      // allow-listed via RENOVATE_ALLOWED_COMMANDS in the Renovate workflow.
      postUpgradeTasks: {
        commands: [
          'bazel run //:gazelle --config=ci',
        ],
        fileFilters: [
          'MODULE.bazel.lock',
        ],
        executionMode: 'branch',
        installTools: {
          bazelisk: {},
        },
      },
    },
    {
      description: 'Group Go module dependency updates',
      matchManagers: [
        'gomod',
      ],
      matchDepTypes: [
        'require',
        'indirect',
      ],
      enabled: true,
      groupName: 'go dependencies',
      labels: [
        'dependencies',
        'go',
      ],
    },
    {
      description: 'Group Go toolchain version from go.mod with Bazel Go SDK',
      matchManagers: [
        'gomod',
      ],
      matchDepTypes: [
        'golang',
      ],
      enabled: true,
      rangeStrategy: 'bump',
      groupName: 'go toolchain',
      labels: [
        'dependencies',
        'go',
      ],
    },
    {
      description: 'Group all GitHub Actions updates',
      matchManagers: [
        'github-actions',
      ],
      groupName: 'github actions',
      labels: [
        'dependencies',
        'github-actions',
      ],
    },
    {
      description: 'Group git hook (pre-commit/prek) updates',
      matchManagers: [
        'pre-commit',
      ],
      groupName: 'git hooks',
      labels: [
        'dependencies',
        'pre-commit',
      ],
    },
    {
      description: 'govulncheck version in the vulnerability scan workflow',
      matchDepNames: [
        'golang.org/x/vuln',
      ],
      matchManagers: [
        'custom.regex',
      ],
      groupName: 'govulncheck',
      labels: [
        'dependencies',
        'go',
      ],
    },
    {
      description: 'golangci-lint: the sha256 pins must be updated by hand',
      matchDepNames: [
        'golangci/golangci-lint',
      ],
      matchManagers: [
        'custom.regex',
      ],
      groupName: 'golangci-lint',
      labels: [
        'dependencies',
      ],
      // addLabels survives the 'major' rule below, which replaces labels.
      // renovate-auto-approve.yaml skips PRs labelled manual-hashes.
      addLabels: [
        'lint',
        'manual-hashes',
      ],
      // Renovate only bumps GOLANGCI_LINT_VERSION; the four http_archive
      // sha256 values in MODULE.bazel stay stale, so the pre-commit hooks job
      // fails on a checksum mismatch until they are updated. Never automerge.
      automerge: false,
      prBodyNotes: [
        '⚠️ **Manual step required:** update all four `golangci_lint_*` `sha256` values in `MODULE.bazel` from `golangci-lint-{{{newVersion}}}-checksums.txt` on the [release page](https://github.com/golangci/golangci-lint/releases/tag/v{{{newVersion}}}). CI only verifies the linux-amd64 hash.',
      ],
    },
    {
      description: 'Major updates require manual review',
      matchUpdateTypes: [
        'major',
      ],
      labels: [
        'dependencies',
        'major',
      ],
      automerge: false,
    },
  ],
}
